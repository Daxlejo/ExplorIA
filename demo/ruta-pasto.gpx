  <metadata>
    <name>Recorrido por el Centro Histórico de Pasto</name>
    <desc>Caminata por 8 lugares emblemáticos del centro de San Juan de Pasto (Nariño, Colombia), con coordenadas verificadas en OpenStreetMap.</desc>
  </metadata>

  <!-- Hitos verificados en OpenStreetMap -->
  <wpt lat="1.2152045" lon="-77.2842910">
    <name>Museo Taminango</name>
    <desc>OSM way/115238095 - Casona colonial de 1623 y museo de artes y tradiciones populares</desc>
  </wpt>
  <wpt lat="1.2146178" lon="-77.2823158">
    <name>Teatro Imperial</name>
    <desc>OSM node/616032279 - Teatro clásico en herradura inaugurado en 1932</desc>
  </wpt>
  <wpt lat="1.2157273" lon="-77.2796246">
    <name>Catedral de Pasto</name>
    <desc>OSM way/91859876 / Wikipedia ES 7182940 - Catedral del Sagrado Corazón de Jesús</desc>
  </wpt>
  <wpt lat="1.2151401" lon="-77.2786570">
    <name>Templo de San Juan Bautista</name>
    <desc>OSM way/115215442 / Wikipedia ES 9856229 - Primera iglesia matriz de Pasto</desc>
  </wpt>
  <wpt lat="1.2146113" lon="-77.2782881">
    <name>Plaza de Nariño</name>
    <desc>OSM way/1078759141 / Wikipedia ES 9855193 - Plaza principal de San Juan de Pasto</desc>
  </wpt>
  <wpt lat="1.2149664" lon="-77.2766597">
    <name>Templo de Cristo Rey</name>
    <desc>OSM way/91859872 / Wikipedia EN 51548567 - Conjunto jesuita de Cristo Rey y San Francisco Javier</desc>
  </wpt>
  <wpt lat="1.2116162" lon="-77.2766887">
    <name>Museo del Oro Nariño</name>
    <desc>OSM node/1999514293 - Centro Cultural Leopoldo López Álvarez del Banco de la República</desc>
  </wpt>
  <wpt lat="1.2105614" lon="-77.2765537">
    <name>Plaza del Carnaval</name>
    <desc>OSM way/567219502 - Escenario principal del Carnaval de Negros y Blancos</desc>
  </wpt>

