# Copia este archivo como local.properties (git lo ignora) y completa los valores.
# Nunca subas tu API key al repositorio.

# Ruta del SDK de Android (Android Studio la escribe sola al abrir el proyecto)
sdk.dir=C\:\\Users\\TU_USUARIO\\AppData\\Local\\Android\\Sdk

# Clave de OpenAI para generar los datos con IA
OPENAI_API_KEY=

# Modelo de OpenAI que generará los datos (por ejemplo gpt-6-luna)
OPENAI_MODEL=gpt-6-luna

# Búsqueda web de OpenAI como respaldo de lugares. Se cobra aparte: déjala en false.
OPENAI_WEB_SEARCH=false
